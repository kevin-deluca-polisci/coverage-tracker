# macOS / editor cruft
.DS_Store
.Rhistory
.Rapp.history
.Rproj.user/
*.Rproj
.idea/
.vscode/

# Raw data — kept local/on cluster, never committed
*.csv.gz
trump_performance_chunks.csv
trump_headlines_analyzed.csv
trump_headlines_master.csv
all_networks_master.csv
data/raw/

# Python local pipeline
.venv/
__pycache__/
*.pyc
scraper_state.json

# Consumed daily increments. The CI job commits data/incoming/YYYY-MM-DD.csv;
# once merge_incoming.py folds a file into the local master it moves it here.
# Git history already holds every increment, so archiving it again would just
# grow the repo (~18 MB/year) for no added recoverability.
data/incoming/archive/

# Secrets
.env
.env.local
*.pem
*.key

# Logs and job outputs
logs/
*.log
*.err
*.out
slurm-*.out

# R session
.Rdata
.Ruserdata
